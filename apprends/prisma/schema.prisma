generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth (NextAuth standard tables) ──────────────────────────────────────────

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String    @unique
  emailVerified  DateTime?
  image          String?
  passwordHash   String?
  role           UserRole  @default(USER)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  accounts       Account[]
  sessions       Session[]
  subscription   Subscription?
  progress       Progress[]
  attempts       Attempt[]
  achievements   UserAchievement[]
  passwordResets PasswordReset[]

  @@index([email])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordReset {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique @default(cuid())
  expires   DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

// ─── Subscriptions ────────────────────────────────────────────────────────────

model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  stripeCustomerId     String             @unique
  stripeSubscriptionId String?            @unique
  plan                 SubscriptionPlan   @default(MONTHLY)
  status               SubscriptionStatus @default(INACTIVE)
  currentPeriodEnd     DateTime?
  trialEnd             DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([stripeCustomerId])
}

// ─── Learning Content ─────────────────────────────────────────────────────────

model Skill {
  id       String      @id @default(cuid())
  name     SkillName   @unique
  label    String
  emoji    String

  sections Section[]
  progress Progress[]
}

model Section {
  id          String      @id @default(cuid())
  skillId     String
  type        SectionType
  title       String
  description String
  order       Int
  icon        String

  skill     Skill      @relation(fields: [skillId], references: [id], onDelete: Cascade)
  exercises Exercise[]

  @@unique([skillId, order])
  @@index([skillId])
}

model Exercise {
  id              String     @id @default(cuid())
  sectionId       String
  level           CefrLevel
  title           String
  audioUrl        String?
  durationSeconds Int?
  payload         Json
  answerKey       Json
  rubric          Json?
  referenceAnswer String?    @db.Text
  maxScore        Int        @default(100)
  xpReward        Int        @default(10)
  isFree          Boolean    @default(false)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  section  Section   @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  attempts Attempt[]

  @@index([sectionId])
}

model Attempt {
  id          String    @id @default(cuid())
  userId      String
  exerciseId  String
  answers     Json
  score       Int       @default(0)
  accuracy    Float     @default(0)
  xpEarned    Int       @default(0)
  aiScore     Int?
  aiBreakdown Json?
  aiFeedback  String?   @db.Text
  gradedAt    DateTime?
  completedAt DateTime  @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([exerciseId])
  @@index([userId, exerciseId])
}

// ─── Gamification ─────────────────────────────────────────────────────────────

model Progress {
  id             String    @id @default(cuid())
  userId         String
  skillId        String
  xp             Int       @default(0)
  level          Int       @default(1)
  streakCount    Int       @default(0)
  longestStreak  Int       @default(0)
  lastActiveDate DateTime?
  streakFrozen   Boolean   @default(false)
  totalAttempts  Int       @default(0)
  updatedAt      DateTime  @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId])
  @@index([userId])
}

model Achievement {
  id          String   @id @default(cuid())
  key         String   @unique
  title       String
  description String
  emoji       String
  xpBonus     Int      @default(0)
  createdAt   DateTime @default(now())

  userAchievements UserAchievement[]
}

model UserAchievement {
  id            String   @id @default(cuid())
  userId        String
  achievementId String
  earnedAt      DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId])
}

// ─── AI Grading Rate Limiting ─────────────────────────────────────────────────

model AiGradingQuota {
  id        String   @id @default(cuid())
  userId    String   @unique
  date      String
  count     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@index([userId, date])
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum UserRole {
  USER
  ADMIN
}

enum SubscriptionPlan {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  ACTIVE
  INACTIVE
  TRIALING
  PAST_DUE
  CANCELED
}

enum SkillName {
  READING
  LISTENING
  WRITING
}

enum CefrLevel {
  A1
  A2
  B1
  B2
  C1
  C2
}

enum SectionType {
  // Reading
  MCQ_MOCK_TEST
  TRUE_FALSE_NOT_GIVEN
  CLOZE_FILL_BLANK
  ARTICLE_COMPREHENSION
  SENTENCE_ORDERING
  GRAMMAR_IN_CONTEXT
  SKIMMING_SCANNING
  VOCABULARY_FLASHCARDS
  // Listening
  LISTENING_MOCK_TEST
  DICTATION
  AUDIO_TRUE_FALSE
  FILL_GAP_AUDIO
  MATCH_AUDIO
  SPEED_DRILLS
  DIALOGUE_COMPREHENSION
  SHADOWING
  // Writing
  WRITING_TASK
  JUMBLE_WORDS
  SENTENCE_CONSTRUCTION
  GUIDED_PARAGRAPH
  GRAMMAR_CORRECTION
  TRANSLATION
  VERB_CONJUGATION
  SPELLING_ACCENTS
}
